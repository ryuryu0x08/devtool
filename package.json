{
  "name": "devtool",
  "private": true,
  "description": "Monorepo: apps/toolbox (web), apps/quotabar (macOS), apps/relay (desktop). The scripts below are the toolbox's, as they were before the move.",
  "workspaces": [
    "apps/toolbox",
    "packages/ui"
  ],
  "scripts": {
    "dev": "npm run dev -w @devtool/toolbox",
    "build": "npm run build -w @devtool/toolbox",
    "preview": "npm run preview -w @devtool/toolbox",
    "typecheck": "npm run typecheck -w @devtool/toolbox",
    "test": "npm run test -w @devtool/toolbox",
    "test:e2e": "npm run test:e2e -w @devtool/toolbox",
    "test:mutation": "npm run test:mutation -w @devtool/toolbox",
    "test:all": "npm run test:all -w @devtool/toolbox"
  }
}
