{
  "name": "@devtool/relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite --port 5174 --strictPort",
    "build:web": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "playwright test",
    "icons": "tauri icon icon.svg -o src-tauri/icons && rm -rf src-tauri/icons/android src-tauri/icons/ios"
  },
  "dependencies": {
    "@devtool/ui": "*",
    "@tauri-apps/api": "2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
